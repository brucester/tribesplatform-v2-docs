{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "tribes-platform",
	"workers_dev": true,
	"compatibility_date": "2026-05-11",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://vzgoulsqmhvhbjhzlzkf.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ6Z291bHNxbWh2aGJqaHpsemtmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc2ODY1MjMsImV4cCI6MjA5MzI2MjUyM30.q3YfwcTFGv6U5eN1Sj031Ia1V-tMtcboZ82PWFQuXg4",
		"NEXT_PUBLIC_APP_URL": "https://tribes-platform.correa-oscar11.workers.dev"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tribes-platform"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}